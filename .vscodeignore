# Source (compiled output in out/ is what we need)
src/

# Secrets — NEVER ship these
.env
.env.*
*.pem
*.key

# Server backend (not part of the extension)
server/

# Landing pages & docs
landing/
docs/

# Dev files — DIRECTORY rules. A bare *.md/*.json denylist cannot reach a nested
# file (vsce globs don't cross "/"), so agent/skill tooling must be excluded by
# directory or all 102 of its files ship. .gitignore learned this; this file didn't.
.vscode/
.github/
.claude/
.agents/
graphify-out/
scripts/
!scripts/uninstall.js
tsconfig.json
railway.toml
competition.ini

# Notes & data — denylist, NOT a by-name list. Every new strategy/outreach file
# would otherwise ship silently: devcut_outreach_devs.csv leaked real developers'
# private email addresses into the 0.1.4 package before this rule existed.
# Only README.md ships (it is the extension's description page).
*.md
!README.md
*.csv
*.tsv
*.json
!package.json

# Images (not used in extension UI — except logo.png). Patterns first, then the
# negation: vsce lets negations win regardless of order, but written this way it
# also reads correctly to anyone who assumes .gitignore precedence.
*.png
*.jpg
*.jpeg
*.svg
!logo.png
gen_logo.py

# Dev tests — not product code
test-*.js

# Build artifacts — needs **/ because vsce globs don't cross directory boundaries
**/*.js.map

# Misc
node_modules/
.gitignore
